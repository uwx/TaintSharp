<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TaintSharp</RootNamespace>
    <AssemblyName>TaintSharp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>TaintSharp</PackageId>
    <Description>.NET bindings for taint, a SPIR-V to WGSL translator built on Google's Tint.</Description>
    <PackageTags>spirv;wgsl;tint;shader;webgpu;gpu</PackageTags>
    <PackageLicenseExpression>MIT AND BSD-3-Clause AND Zlib AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <NativeAssetsRoot>$(MSBuildThisFileDirectory)../../artifacts/native</NativeAssetsRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(NativeAssetsRoot)/win-x64/*" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('$(NativeAssetsRoot)/win-x64')" />
    <None Include="$(NativeAssetsRoot)/linux-x64/*" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="Exists('$(NativeAssetsRoot)/linux-x64')" />
    <None Include="$(NativeAssetsRoot)/osx-arm64/*" Pack="true" PackagePath="runtimes/osx-arm64/native/" Condition="Exists('$(NativeAssetsRoot)/osx-arm64')" />
  </ItemGroup>
</Project>
